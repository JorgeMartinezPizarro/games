# Development environment, shared by:
#  - `make dev`: full docker stack (games + Nextcloud 34 + MariaDB +
#    stockfish + wordlist), see docker-compose.dev.yml.
#  - `npm run dev`: hot-reloading Next.js on DEV_PORT. Next loads this file
#    only in `next dev` (on top of .env), so it also connects to the
#    Nextcloud and the services of `make dev`.
#
# Unusual ports on purpose, so they don't clash with prod (.env) or with
# e2e (.env.e2e). Everything listens on 127.0.0.1 only: the credentials here
# are toy values. To change something only on your machine, use
# .env.development.local (gitignored, read by both Next and the Makefile).

# Hot-reloading Next.js (`npm run dev`) and dockerized games (`make dev`).
DEV_PORT=4400
PORT=4401

# Development Nextcloud 34: http://localhost:4480
NEXTCLOUD_PORT=4480
NEXTCLOUD_URL=http://localhost:4480
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=gaming-dev-4480
# Test users (space-separated), all with the same password.
NEXTCLOUD_TEST_USERS=ana bob
NEXTCLOUD_TEST_PASSWORD=gaming-dev-4480
NEXTCLOUD_GAMING_SECRET=gaming-dev-secret
# What the gaming app's iframe loads. Defaults to the dockerized games;
# set http://localhost:4400/bookmarks to see your `npm run dev` inside
# Nextcloud (and run `make dev` again).
NEXTCLOUD_GAMES_URL=http://localhost:4401/bookmarks

STOCKFISH_PORT=4407
WORDLIST_PORT=4409
NEXT_PUBLIC_CHESS_URL=http://localhost:4407
NEXT_PUBLIC_WORD_URL=http://localhost:4409

MARIADB_HOST=localhost
MARIADB_PORT=4406
MARIADB_DATABASE=games
MARIADB_USER=games
MARIADB_PASSWORD=gaming-dev-db
MARIADB_ROOT_PASSWORD=gaming-dev-db-root
