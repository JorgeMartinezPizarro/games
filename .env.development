# Entorno de desarrollo, compartido por:
#  - `make dev`: stack docker completo (games + Nextcloud 34 + MariaDB +
#    stockfish + wordlist), ver docker-compose.dev.yml.
#  - `npm run dev`: Next.js en caliente en DEV_PORT. Next carga este fichero
#    solo en `next dev` (por encima de .env), así que también se conecta al
#    Nextcloud y a los servicios de `make dev`.
#
# Puertos poco habituales a propósito, para no chocar con prod (.env) ni con
# e2e (.env.e2e). Todo escucha solo en 127.0.0.1: las credenciales de aquí
# son de juguete. Para cambiar algo solo en tu máquina, usa
# .env.development.local (gitignorado, lo leen tanto Next como el Makefile).

# Next.js en caliente (`npm run dev`) y games dockerizado (`make dev`).
DEV_PORT=4400
PORT=4401

# Nextcloud 34 de desarrollo: http://localhost:4480
NEXTCLOUD_PORT=4480
NEXTCLOUD_URL=http://localhost:4480
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=gaming-dev-4480
# Usuarios de prueba (separados por espacios), todos con la misma contraseña.
NEXTCLOUD_TEST_USERS=ana bob
NEXTCLOUD_TEST_PASSWORD=gaming-dev-4480
NEXTCLOUD_GAMING_SECRET=gaming-dev-secret
# Qué carga el iframe de la app gaming. Por defecto el games dockerizado;
# pon http://localhost:4400/bookmarks para ver tu `npm run dev` dentro de
# Nextcloud (y vuelve a lanzar `make dev`).
NEXTCLOUD_GAMES_URL=http://localhost:4401/bookmarks

STOCKFISH_PORT=4407
WORDLIST_PORT=4409
NEXT_PUBLIC_CHESS_URL=http://localhost:4407
NEXT_PUBLIC_WORD_URL=http://localhost:4409

MARIADB_HOST=localhost
MARIADB_PORT=4406
MARIADB_DATABASE=games
MARIADB_USER=games
MARIADB_PASSWORD=gaming-dev-db
MARIADB_ROOT_PASSWORD=gaming-dev-db-root
