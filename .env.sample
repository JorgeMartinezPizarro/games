# Prod (`make prod`). The development environment is separate, in .env.development.
PORT=1234
NEXTCLOUD_URL=https://your-cloud-url
# Only if the browser reaches Nextcloud through a different URL than the server
# (e.g. internal docker network): where users are sent to log in. Defaults to NEXTCLOUD_URL.
# NEXTCLOUD_PUBLIC_URL=https://your-cloud-url
# Secret shared with the Nextcloud "gaming" app (its shared_secret,
# see nextcloud/custom_apps/gaming/README.md). Signs the activity and the
# record notifications; without it nothing is published to Nextcloud.
NEXTCLOUD_GAMING_SECRET=change-me
NEXT_PUBLIC_CHESS_URL=http://localhost:1999
NEXT_PUBLIC_WORD_URL=http://localhost:2000

# MariaDB: these values are for running `games` outside docker (npm run
# start) against the MariaDB from `docker compose up`, just like
# NEXT_PUBLIC_CHESS_URL/WORD_URL point to localhost. Inside
# docker-compose.yml, the "games" service itself already overrides
# MARIADB_HOST/PORT to "mariadb"/3306 (internal compose network), so only
# DATABASE/USER/PASSWORD/ROOT_PASSWORD below are used in that case.
MARIADB_HOST=localhost
MARIADB_PORT=1010
MARIADB_DATABASE=games
MARIADB_USER=games
MARIADB_PASSWORD=change-me
MARIADB_ROOT_PASSWORD=change-me-root

# Used by `make save`/`make load` to back up and restore ./cache
# (audio, database) as a docker image, tagged gaming-app-latest and
# gaming-app-DD-MM-YYYY.
VOLUMES_DOCKER_USER=jorgemartinezpizarro
VOLUMES_IMAGE_NAME=games-volumes
