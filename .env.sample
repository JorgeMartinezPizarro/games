# Prod (`make prod`). El entorno de desarrollo va aparte, en .env.development.
PORT=1234
NEXTCLOUD_URL=https://your-cloud-url
# Solo si el navegador llega a Nextcloud por otra URL que el servidor (p. ej.
# red interna de docker): adonde se manda a iniciar sesión. Por defecto, NEXTCLOUD_URL.
# NEXTCLOUD_PUBLIC_URL=https://your-cloud-url
# Secreto compartido con la app "gaming" de Nextcloud (su shared_secret,
# ver nextcloud/custom_apps/gaming/README.md). Firma la actividad y las
# notificaciones de récords; sin él no se publica nada en Nextcloud.
NEXTCLOUD_GAMING_SECRET=change-me
NEXT_PUBLIC_CHESS_URL=http://localhost:1999
NEXT_PUBLIC_WORD_URL=http://localhost:2000

# MariaDB: estos valores son para correr `games` sin dockerizar (npm run
# start) contra el MariaDB del `docker compose up`, igual que
# NEXT_PUBLIC_CHESS_URL/WORD_URL apuntan a localhost. Dentro de
# docker-compose.yml, el propio servicio "games" ya sobreescribe
# MARIADB_HOST/PORT a "mariadb"/3306 (red interna de compose), así que solo
# DATABASE/USER/PASSWORD/ROOT_PASSWORD de aquí abajo se usan en ese caso.
MARIADB_HOST=localhost
MARIADB_PORT=1010
MARIADB_DATABASE=games
MARIADB_USER=games
MARIADB_PASSWORD=change-me
MARIADB_ROOT_PASSWORD=change-me-root

# Usados por `make save`/`make load` para respaldar y restaurar ./cache
# (audio, base de datos) como imagen docker, con tags gaming-app-latest y
# gaming-app-DD-MM-YYYY.
VOLUMES_DOCKER_USER=jorgemartinezpizarro
VOLUMES_IMAGE_NAME=games-volumes
