# Image used only as a carrier to back up/restore VOLUMES_DIR
# (audio, database, etc). It runs nothing, it only packages the content.
# Built with VOLUMES_DIR as the context (see `make save`); inside the image
# the data stays under /cache/, so older backups still restore.
FROM scratch

COPY audio/ /cache/audio/
COPY database/ /cache/database/

CMD ["true"]
