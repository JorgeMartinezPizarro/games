# Template for .env.e2e (copy this file to .env.e2e; that one is
# gitignored). Used only by docker-compose.e2e.yml + playwright.config.ts.
#
# Ports differ from the dev ones (.env.development) on purpose, so both
# stacks can be up at the same time without clashing.
PORT=3101
NEXT_PUBLIC_CHESS_URL=http://localhost:1107
NEXT_PUBLIC_WORD_URL=http://localhost:1109
STOCKFISH_PORT=1107
WORDLIST_PORT=1109
MARIADB_PORT=1110

# Nextcloud 34 of the e2e stack (docker-compose.nextcloud.yml). Playwright logs
# in with the first test user (e2e/auth.setup.ts) and the tests reuse that
# session, just like a real user inside Nextcloud.
NEXTCLOUD_PORT=1180
NEXTCLOUD_URL=http://localhost:1180
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=e2e-admin-1180
NEXTCLOUD_TEST_USERS=e2e-tester
NEXTCLOUD_TEST_PASSWORD=e2e-tester-1180
NEXTCLOUD_GAMING_SECRET=e2e-gaming-secret
NEXTCLOUD_GAMES_URL=http://localhost:3101/bookmarks

# The dockerized "games" service (docker-compose.e2e.yml) talks to MariaDB
# over the internal compose network, not through this host port — only
# DATABASE/USER/PASSWORD need to exist to initialize the container.
MARIADB_DATABASE=games
MARIADB_USER=games
MARIADB_PASSWORD=e2e-password
MARIADB_ROOT_PASSWORD=e2e-root-password
