# Plantilla para .env.e2e (copia este fichero a .env.e2e; ese sí está
# gitignorado). Usado solo por docker-compose.e2e.yml + playwright.config.ts.
#
# Puertos distintos a los de dev (.env.development) a propósito, para poder
# tener ambos stacks levantados a la vez sin chocar.
PORT=3101
NEXT_PUBLIC_CHESS_URL=http://localhost:1107
NEXT_PUBLIC_WORD_URL=http://localhost:1109
STOCKFISH_PORT=1107
WORDLIST_PORT=1109
MARIADB_PORT=1110

# Nextcloud 34 del stack e2e (docker-compose.nextcloud.yml). Playwright inicia
# sesión con el primer usuario de prueba (e2e/auth.setup.ts) y los tests
# usan esa sesión, igual que un usuario real dentro de Nextcloud.
NEXTCLOUD_PORT=1180
NEXTCLOUD_URL=http://localhost:1180
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=e2e-admin-1180
NEXTCLOUD_TEST_USERS=e2e-tester
NEXTCLOUD_TEST_PASSWORD=e2e-tester-1180
NEXTCLOUD_GAMING_SECRET=e2e-gaming-secret
NEXTCLOUD_GAMES_URL=http://localhost:3101/bookmarks

# El servicio "games" dockerizado (docker-compose.e2e.yml) habla con MariaDB
# por red interna de compose, no por este puerto de host — solo hace falta
# que DATABASE/USER/PASSWORD existan para inicializar el contenedor.
MARIADB_DATABASE=games
MARIADB_USER=games
MARIADB_PASSWORD=e2e-password
MARIADB_ROOT_PASSWORD=e2e-root-password
